FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HOME=/cache/huggingface
WORKDIR /app
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
COPY requirements-service-b.txt requirements-service-b-model.txt ./
RUN pip install --no-cache-dir torch==2.8.0 --index-url ${TORCH_INDEX_URL} \
    && pip install --no-cache-dir -r requirements-service-b-model.txt
COPY src ./src
COPY configs ./configs
EXPOSE 8001
CMD ["uvicorn", "src.app.service_b.main:app", "--host", "0.0.0.0", "--port", "8001", "--log-level", "info", "--log-config", "configs/service_b_logging.json"]
