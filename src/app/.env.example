# Copy to src/app/.env (or export in your shell) before running Service A or Alembic.
DATABASE_URL=postgresql+psycopg://movierec:movierec@localhost:5432/movierec
SERVICE_B_MODE=mock
SERVICE_B_BASE_URL=http://localhost:8001
# Per-worker in-flight request cap; overload returns HTTP 503 + Retry-After.
# Default SQLAlchemy capacity is 5 pooled + 10 overflow connections per worker.
SERVICE_A_MAX_IN_FLIGHT=12
